<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="portal_sign_requests" model="portal.entry">
        <field name="name">Signature Requests</field>
        <field name="description">View, or sign documents</field>
        <field name="url">/my/sign_requests</field>
        <field
            name="image"
            type="bytes"
            file="sign_oca/static/src/img/portal_signature.svg"
        />
        <field name="placeholder_count">sign_oca_count</field>
        <field name="category">client_category</field>
    </record>
    <record id="portal_sign_required" model="portal.entry">
        <field name="name">Signature Required</field>
        <field
            name="description"
        >Action required: review and sign your agreements</field>
        <field name="url">/my/sign_requests?filterby=pending</field>
        <field
            name="image"
            type="bytes"
            file="sign_oca/static/src/img/portal_signature.svg"
        />
        <field name="placeholder_count">sign_oca_pending_count</field>
        <field name="category">alert</field>
        <field name="sequence" eval="10" />
    </record>
</odoo>
